#!/bin/bash
# =============================================================================
# VedaDB Server - macOS Post-Install Script
# =============================================================================
# Description:
#   Runs after package extraction. Creates service user/group, data directories,
#   generates configuration, creates symlinks, installs LaunchAgent, and starts
#   the VedaDB Server service.
#
# Called by:
#   pkgbuild --scripts ./scripts (invoked by build-pkg.sh)
#
# Environment:
#   Runs as root during PKG installation.
# =============================================================================

set -euo pipefail

# --- Configuration ---
VEDADB_USER="vedadb"
VEDADB_GROUP="vedadb"
INSTALL_DIR="/opt/vedadb"
DATA_DIR="/usr/local/var/vedadb"
LOG_DIR="/usr/local/var/vedadb/logs"
CONFIG_DIR="/opt/vedadb/etc"
LAUNCH_AGENT_LABEL="io.vedadb.server"
LAUNCH_AGENT_PLIST="$INSTALL_DIR/share/io.vedadb.server.plist"
SYMLINK_DIR="/usr/local/bin"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_ok() {
    echo -e "${GREEN}[OK]${NC}   $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# --- Header ---
echo ""
echo "==================================="
echo "  VedaDB Server Configuration"
echo "==================================="
echo ""

# --- Detect real user (the one running installer, not root) ---
# SECURE: Use stat on install directory to detect invoking user (HIGH-016 fix)
# SUDO_USER can be manipulated by the caller, so we use the directory ownership
REAL_USER="${SUDO_USER:-$USER}"
INSTALLER_PARENT="$(dirname "$INSTALL_DIR")"
if [[ -d "$INSTALLER_PARENT" ]] && [[ "$REAL_USER" == "root" ]]; then
    # Use stat to find the owner of the parent directory as fallback
    STAT_USER="$(stat -f '%Su' "$INSTALLER_PARENT" 2>/dev/null || true)"
    if [[ -n "$STAT_USER" && "$STAT_USER" != "root" ]]; then
        REAL_USER="$STAT_USER"
    else
        # Final fallback: try to find first non-root logged-in user
        REAL_USER="$(who | awk '{print $1}' | grep -v '^root$' | head -1)"
    fi
fi

log_info "Installing user: $REAL_USER"
log_info "Install directory: $INSTALL_DIR"

# --- Step 1: Create service group ---
log_info "Step 1/8: Creating service group '$VEDADB_GROUP'..."
if ! dscl . read "/Groups/$VEDADB_GROUP" &>/dev/null; then
    # Find next available GID (starting after system GIDs)
    NEXT_GID=$(dscl . -list /Groups PrimaryGroupID 2>/dev/null | \
        awk '{print $2}' | sort -n | tail -1)
    NEXT_GID=$((NEXT_GID + 1))

    dscl . -create "/Groups/$VEDADB_GROUP"
    dscl . -create "/Groups/$VEDADB_GROUP" PrimaryGroupID "$NEXT_GID"
    dscl . -create "/Groups/$VEDADB_GROUP" RecordName "$VEDADB_GROUP"
    log_ok "Created group '$VEDADB_GROUP' (GID: $NEXT_GID)"
else
    log_warn "Group '$VEDADB_GROUP' already exists, skipping."
fi

# --- Step 2: Create service user (no-login account) ---
log_info "Step 2/8: Creating service user '$VEDADB_USER'..."
if ! dscl . read "/Users/$VEDADB_USER" &>/dev/null; then
    # Find next available UID
    NEXT_UID=$(dscl . -list /Users UniqueID 2>/dev/null | \
        awk '{print $2}' | sort -n | tail -1)
    NEXT_UID=$((NEXT_UID + 1))

    # Get the GID of our group
    GID=$(dscl . -read "/Groups/$VEDADB_GROUP" PrimaryGroupID 2>/dev/null | \
        awk '{print $2}' || echo "$NEXT_GID")

    dscl . -create "/Users/$VEDADB_USER"
    dscl . -create "/Users/$VEDADB_USER" UniqueID "$NEXT_UID"
    dscl . -create "/Users/$VEDADB_USER" PrimaryGroupID "$GID"
    dscl . -create "/Users/$VEDADB_USER" UserShell /usr/bin/false
    dscl . -create "/Users/$VEDADB_USER" NFSHomeDirectory "$DATA_DIR"
    dscl . -create "/Users/$VEDADB_USER" RecordName "$VEDADB_USER"
    # Hide from login window
    dscl . -create "/Users/$VEDADB_USER" Password "*"
    log_ok "Created user '$VEDADB_USER' (UID: $NEXT_UID, GID: $GID)"
else
    log_warn "User '$VEDADB_USER' already exists, skipping."
fi

# --- Step 3: Create data directories ---
log_info "Step 3/8: Creating data directories..."
mkdir -p "$DATA_DIR/data"
mkdir -p "$LOG_DIR"
mkdir -p "$CONFIG_DIR"

# Set ownership
chown -R "$VEDADB_USER:$VEDADB_GROUP" "$DATA_DIR"
chmod 755 "$DATA_DIR"
chmod 750 "$DATA_DIR/data"
log_ok "Data directories created at $DATA_DIR"

# --- Step 4: Generate configuration ---
log_info "Step 4/8: Generating configuration..."
if [[ ! -f "$CONFIG_DIR/config.yaml" ]]; then
    if [[ -x "$INSTALL_DIR/bin/vedadb-config-generator" ]]; then
        "$INSTALL_DIR/bin/vedadb-config-generator" \
            --os darwin \
            --data-dir "$DATA_DIR/data" \
            --log-dir "$LOG_DIR" \
            --output "$CONFIG_DIR/config.yaml"
        chown root:"$VEDADB_GROUP" "$CONFIG_DIR/config.yaml"
        chmod 640 "$CONFIG_DIR/config.yaml"
        log_ok "Configuration generated at $CONFIG_DIR/config.yaml"
    else
        log_warn "Config generator not found, creating basic config..."
        cat > "$CONFIG_DIR/config.yaml" << 'EOF'
server:
  port: 7480
  host: 127.0.0.1
  data_dir: /usr/local/var/vedadb/data
  max_connections: 1000
  query_timeout: 30s

auth:
  enabled: true
  method: password
  admin_user: admin

logging:
  level: info
  file: /usr/local/var/vedadb/logs/vedadb-server.log
  max_size: 100MB
  max_files: 5
  format: json

engines:
  document:
    enabled: true
  keyvalue:
    enabled: true
  graph:
    enabled: true
  vector:
    enabled: true
  timeseries:
    enabled: true
EOF
        chown root:"$VEDADB_GROUP" "$CONFIG_DIR/config.yaml"
        chmod 640 "$CONFIG_DIR/config.yaml"
        log_ok "Basic configuration created."
    fi
else
    log_warn "Config already exists at $CONFIG_DIR/config.yaml, skipping generation."
fi

# --- Step 5: Create symlinks ---
log_info "Step 5/8: Creating symlinks in /usr/local/bin..."
for binary in vedadb-server vedadb-cli vedadb-bench vedadb-backup; do
    if [[ -f "$INSTALL_DIR/bin/$binary" ]]; then
        ln -sf "$INSTALL_DIR/bin/$binary" "$SYMLINK_DIR/$binary"
        log_ok "  $binary -> $INSTALL_DIR/bin/$binary"
    else
        log_warn "  $binary not found in $INSTALL_DIR/bin"
    fi
done

# --- Step 6: Install LaunchAgent ---
log_info "Step 6/8: Installing LaunchAgent..."

# Determine LaunchAgents directory for the installing user
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"
if [[ -n "${SUDO_USER:-}" ]]; then
    REAL_HOME=$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | \
        sed 's/^NFSHomeDirectory: //' || echo "/Users/$SUDO_USER")
    LAUNCH_AGENTS_DIR="$REAL_HOME/Library/LaunchAgents"
fi

mkdir -p "$LAUNCH_AGENTS_DIR"

# Copy the LaunchAgent plist
if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then
    cp "$LAUNCH_AGENT_PLIST" "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist"
else
    # Use bundled plist from package
    cp "$INSTALL_DIR/share/io.vedadb.server.plist" "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist" 2>/dev/null || \
    cat > "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist" << 'PLIST_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.vedadb.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/vedadb/bin/vedadb-server</string>
        <string>--config</string>
        <string>/opt/vedadb/etc/config.yaml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/usr/local/var/vedadb/logs/vedadb-server.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/vedadb/logs/vedadb-server.error.log</string>
    <key>WorkingDirectory</key>
    <string>/usr/local/var/vedadb</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
PLIST_EOF
fi

# Fix ownership of plist for the real user
if [[ -n "${SUDO_USER:-}" ]]; then
    chown "$SUDO_USER:$(id -gn "$SUDO_USER" 2>/dev/null || echo staff)" \
        "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist" 2>/dev/null || true
fi

chmod 644 "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist"
log_ok "LaunchAgent installed at $LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist"

# --- Step 7: Load and start service ---
log_info "Step 7/8: Starting VedaDB Server..."

# Unload first in case of previous install
launchctl unload "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist" 2>/dev/null || true
sleep 1

# Load the LaunchAgent
if launchctl load -w "$LAUNCH_AGENTS_DIR/$LAUNCH_AGENT_LABEL.plist" 2>/dev/null; then
    log_ok "LaunchAgent loaded."
    sleep 2

    # Start the service
    if launchctl start "$LAUNCH_AGENT_LABEL" 2>/dev/null; then
        log_ok "VedaDB Server started."
    else
        log_warn "Could not start service (it may auto-start at next login)."
    fi
else
    log_warn "Could not load LaunchAgent (user may need to log out and back in)."
fi

# --- Step 8: Verify installation ---
log_info "Step 8/8: Verifying installation..."

# Check binary exists and is executable
if [[ -x "$INSTALL_DIR/bin/vedadb-server" ]]; then
    log_ok "Server binary verified."
else
    log_error "Server binary not found or not executable!"
fi

# Check data directory
if [[ -d "$DATA_DIR/data" ]]; then
    log_ok "Data directory verified."
else
    log_error "Data directory not created!"
fi

# Check config
if [[ -f "$CONFIG_DIR/config.yaml" ]]; then
    log_ok "Configuration file verified."
else
    log_error "Configuration file not found!"
fi

# --- Summary ---
echo ""
echo "==================================="
echo -e "  ${GREEN}Installation Complete!${NC}"
echo "==================================="
echo ""
echo "  Install directory: $INSTALL_DIR"
echo "  Data directory:    $DATA_DIR/data"
echo "  Config file:       $CONFIG_DIR/config.yaml"
echo "  Log files:         $LOG_DIR"
echo "  CLI tool:          vedadb-cli"
echo ""
echo "  Service management:"
echo "    launchctl start io.vedadb.server"
echo "    launchctl stop io.vedadb.server"
echo "    launchctl list io.vedadb.server"
echo ""
echo "  Uninstall:         $INSTALL_DIR/uninstall.sh"
echo ""
echo "==================================="
echo ""

exit 0
